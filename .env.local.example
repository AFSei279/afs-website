# Kopiere diese Datei zu .env.local und fülle die Werte aus.
# .env.local ist gitignored.

# --- Lead-Formular ---
# Endpoint des Form-Providers, an den das Kontaktformular postet.
# Empfehlung: Web3Forms (https://web3forms.com) — kostenloses Konto, EU-konform.
# Bei Web3Forms ist der Endpoint immer "https://api.web3forms.com/submit".
NEXT_PUBLIC_LEAD_FORM_ENDPOINT=https://api.web3forms.com/submit

# Web3Forms Access Key (bei Web3Forms-Anmeldung erhalten — leer lassen wenn anderer Provider).
NEXT_PUBLIC_LEAD_FORM_ACCESS_KEY=

# --- Analytics ---
# Plausible-Domain (z. B. "afs-ta.com"). Leer = Plausible-Skript wird nicht eingebunden.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Site ---
# Wird in Sitemap und Open-Graph-Tags genutzt. Ohne abschließenden Slash.
NEXT_PUBLIC_SITE_URL=https://afs-ta.com
